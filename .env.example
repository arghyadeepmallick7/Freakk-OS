# ==================================================
# FREAKOS Discord Bot - Environment Configuration
# ==================================================

# Discord Bot Token from Discord Developer Portal (REQUIRED)
# Go to https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=your_discord_bot_token_here

# SQLite Database File Path (Defaults to data/freakos.db)
DATABASE_PATH=data/freakos.db

# Bot Owner Discord IDs (comma-separated, optional)
OWNER_IDS=123456789012345678,234567890123456789

# Optional: Development Guild ID for instant slash command sync
# Leave empty for global production sync
DEV_GUILD_ID=
